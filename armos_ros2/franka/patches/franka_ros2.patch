-                        error=(
-                            'Motion cancelled but failed to restore SwitchedOn: '
-                            f'{rearm.message}'
-                        ),
-                        cancelled=False,
-                    )
-                return MotionResult(
-                    success=False,
-                    error='Motion cancelled',
-                    cancelled=True,
-                )
-
-            if poll.error:
-                return MotionResult(success=False, error=poll.error)
-
