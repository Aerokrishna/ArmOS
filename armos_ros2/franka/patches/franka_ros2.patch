-                    self.logger.error(f'Spine entered fault state: {state}')
-                    return _PollOutcome(error=f'Spine entered fault state: {state}')
-
-            if motion_done.is_set():
-                return _PollOutcome()
-
-            time.sleep(period)
-
-        return _PollOutcome()
