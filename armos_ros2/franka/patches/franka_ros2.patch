-    def move_absolute(
-        self,
-        position: float,
-        velocity: float,
-        acceleration: float,
-        deceleration: float,
-        is_cancelled: Callable[[], bool] = lambda: False,
-        on_feedback: Optional[Callable[[float], None]] = None,
