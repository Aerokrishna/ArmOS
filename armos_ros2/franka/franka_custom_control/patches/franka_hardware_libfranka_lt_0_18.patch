         src/franka_param_service_server.cpp
         src/robot.cpp
         src/ros_libfranka_logger.cpp
-
-        src/actions_helper/ptp_motion_handler.cpp
 )
 
+# The PTP motion action needs libfranka's async position control (added in 0.18.0, robot
+# server protocol 10). Older libfranka (e.g. 0.17.x for FR3 system images 5.7/5.8) builds
+# without it; the error_recovery action is unaffected.
+if(Franka_VERSION VERSION_GREATER_EQUAL 0.18.0)
+  target_sources(franka_hardware PRIVATE src/actions_helper/ptp_motion_handler.cpp)
+else()
+  message(WARNING "libfranka ${Franka_VERSION} < 0.18.0: PTP motion action server disabled")
+  target_compile_definitions(franka_hardware PUBLIC FRANKA_HARDWARE_NO_PTP)
+endif()
+
 target_include_directories(
         franka_hardware
         PRIVATE
