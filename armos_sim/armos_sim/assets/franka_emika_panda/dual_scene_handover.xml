<mujoco model="panda handover scene">
  <!-- dual_scene.xml + a table and a free cylinder (5 cm diameter, 10 cm long) for examples/bimanual_handover.py -->
  <include file="dual_panda.xml"/>

  <statistic center="0.3 0.25 0.4" extent="1"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- table in front of the right arm, top at z = 0.2 m -->
    <body name="table" pos="0.45 -0.15 0.1">
      <geom name="table" type="box" size="0.12 0.12 0.1" rgba="0.55 0.45 0.35 1"/>
    </body>

    <!-- the object: lying on the table, axis along world y (pointing from the right arm to the left) -->
    <body name="cylinder" pos="0.45 -0.15 0.2255" quat="0.7071068 -0.7071068 0 0">
      <freejoint name="cylinder_joint"/>
      <geom name="cylinder" type="cylinder" size="0.025 0.05" mass="0.1" rgba="0.85 0.35 0.1 1"
        friction="1.5 0.02 0.0001" condim="4"/>
    </body>
  </worldbody>
</mujoco>
