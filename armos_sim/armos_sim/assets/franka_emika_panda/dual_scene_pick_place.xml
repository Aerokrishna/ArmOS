<mujoco model="panda bimanual pick and place scene">
  <!-- dual_scene.xml + a table between the arms and a long box (30 x 5 x 5 cm) for examples/bimanual_spatial.py -->
  <include file="dual_panda.xml"/>

  <statistic center="0.4 0.25 0.3" extent="1"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- table between the arms, top at z = 0.2 m -->
    <body name="table" pos="0.5 0.25 0.1">
      <geom name="table" type="box" size="0.16 0.32 0.1" rgba="0.55 0.45 0.35 1"/>
    </body>

    <!-- the object: a box lying on the table, long axis along world y (from one arm to the other), off-center
         towards the right arm so the two arms reach different distances -->
    <body name="box" pos="0.42 0.18 0.2255">
      <freejoint name="box_joint"/>
      <geom name="box" type="box" size="0.025 0.15 0.025" mass="0.3" rgba="0.2 0.5 0.85 1"
        friction="1.5 0.02 0.0001" condim="4"/>
    </body>

    <!-- place target: footprint of the box at the place pose (0.56, 0.25), yaw 25 deg (visual only) -->
    <site name="place_marker" type="box" pos="0.56 0.25 0.2008" quat="0.9763 0 0 0.2164" size="0.025 0.15 0.0008"
      rgba="0 0.9 0.2 0.5"/>
  </worldbody>
</mujoco>
